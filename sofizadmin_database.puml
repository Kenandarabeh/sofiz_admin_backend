    # related_wallet_id : FK -> StellarWallet [nullable]
    # related_supplier_id : FK -> SupplierAccount [nullable]
    # related_baridimob_id : FK -> BaridiMobAccount [nullable]
    + reference : CharField(100) [nullable]
    + notes : TextField [nullable]
    + created_at : DateTimeField [auto_now_add]
    + updated_at : DateTimeField [auto_now]
    --
    .. Accounting Role ..
    * Consumed capital: Added to LEFT SIDE of Golden Balance Equation
    * Proxies: GamingExpenseRecord, UtilityExpenseRecord
  }
}

' ==============================================================================
' 7. REVENUE, SALES & PROFIT MARGINS
' ==============================================================================
package "7. Revenue & Operational Profit Units" as PkgRevenue #161B22 {
  class GameProfitRecord << (P,#3FB950) Revenue Ledger >> {
    + id : BigAutoField [PK]
    + order_reference : CharField(100) [unique, indexed]
    + game_code : CharField(50) [freefire | pubgm | etc.]
    + game_title : CharField(150) [nullable]
    + package_name : CharField(150) [nullable]
    + player_id : CharField(100) [nullable]
    + cost_price_usd : DecimalField(12,4)
    + cost_price_dzd : DecimalField(15,2)
    + sale_price_dzd : DecimalField(15,2)
    + net_profit_dzd : DecimalField(15,2) [auto-computed]
