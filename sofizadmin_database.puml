  class UtilityBillRecord << (U,#3FB950) Settlement Unit >> {
    + id : BigAutoField [PK]
    + service : CharField(30) [SONELGAZ | ADE | ALGERIE_TELECOM]
    + bill_reference : CharField(100) [unique, indexed]
    + customer_account : CharField(100) [nullable]
    + bill_amount_dzd : DecimalField(15,2)
    + commission_earned_dzd : DecimalField(15,2) [default=0.00]
    + is_settled : BooleanField [default=False]
    # baridimob_account_id : FK -> BaridiMobAccount [nullable]
    + payment_date : DateTimeField [indexed]
    + created_at : DateTimeField [auto_now_add]
    + updated_at : DateTimeField [auto_now]
    --
    .. Service Settlement ..
    * Manages municipal utility collections (electricity, water, fiber telecom)
  }
}

' ==============================================================================
' 8. BALANCE AUDIT ENGINE (GOLDEN EQUATION)
' ==============================================================================
package "8. Institutional Financial Audit Engine" as PkgAudit #161B22 {
  class BalanceAuditLog << (B,#F0883E) Immutable Financial Audit >> {
    + id : BigAutoField [PK]
    + checked_at : DateTimeField [auto_now_add, indexed]
    -- Left Side Components (Total Assets + Incurred Expenses) --
    + total_dzt_wallets : DecimalField(18,2)
    + total_g2bulk_dzd : DecimalField(18,2)
    + total_baridimob_dzd : DecimalField(18,2)
    + total_in_transit_dzd : DecimalField(18,2)
    + total_assets_dzd : DecimalField(18,2)
    + total_expenses_dzd : DecimalField(18,2)
    + left_side_total : DecimalField(18,2)
    -- Right Side Components (Total Liabilities + Injected Capital + Profits) --
    + total_capital_dzd : DecimalField(18,2)
    + total_profits_dzd : DecimalField(18,2)
    + right_side_total : DecimalField(18,2)
    -- Mathematical Audit Discrepancy --
    + discrepancy_dzd : DecimalField(18,2)
    + status : CharField(30) [BALANCED | DISCREPANCY_DETECTED, indexed]
    + notes : TextField [nullable]
    --
    .. The Golden Balance Mathematical Law ..
    * LEFT_SIDE = Stellar DZT + G2Bulk DZD + Binance USDT(DZD) + BaridiMob + In-Transit + Expenses
    * RIGHT_SIDE = Capital Injections + Cumulative Net Profits
    * Discrepancy = LEFT_SIDE - RIGHT_SIDE
    * BALANCED if Discrepancy == 0.00, otherwise DISCREPANCY_DETECTED
  }
}

