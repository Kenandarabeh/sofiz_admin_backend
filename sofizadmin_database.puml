' ==============================================================================
' RELATIONSHIPS & FOREIGN KEYS
' ==============================================================================

' Global Settings Routing
MonitoringGlobalSettings --> StellarWallet : "games_collection_wallet\n(Central Games DZT Inflow)"
MonitoringGlobalSettings --> StellarWallet : "central_treasury_wallet\n(Master Vault Target)"

' Stellar Sweeps
WalletSweepLog --> StellarWallet : "source_wallet"
WalletSweepLog --> StellarWallet : "destination_wallet"

' Capital Entries
CapitalEntry --> StellarWallet : "destination_wallet"
CapitalEntry --> SupplierAccount : "destination_supplier"
CapitalEntry --> BaridiMobAccount : "destination_baridimob"

' Withdrawal Record Flow
WithdrawalRecord --> StellarWallet : "source_wallet"
WithdrawalRecord --> BaridiMobAccount : "source_baridimob"
WithdrawalRecord --> SupplierAccount : "destination_supplier"
WithdrawalRecord --> BaridiMobFundingReceipt : "funding_receipt"

' Funding Pipeline Links
BaridiMobFundingReceipt --> StellarWallet : "source_wallet"
BaridiMobFundingReceipt --> StellarWallet : "destination_wallet"
BaridiMobFundingReceipt --> ExpenseRecord : "expense_record\n(50 DZD Postal Fee)"
BaridiMobFundingReceipt --> SupplierAccount : "supplier_account\n(G2Bulk USD Target)"
BaridiMobFundingReceipt --> WithdrawalRecord : "withdrawal_record\n(Outflow Trigger)"

' Expenses Relations
ExpenseRecord --> StellarWallet : "related_wallet"
ExpenseRecord --> SupplierAccount : "related_supplier"
ExpenseRecord --> BaridiMobAccount : "related_baridimob"

' Revenue & Bills
