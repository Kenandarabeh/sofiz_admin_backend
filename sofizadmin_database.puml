package "6. Operating Expenses & Fee Tracking" as PkgExpense #161B22 {
  class ExpenseRecord << (E,#FF7B72) Outflow Ledger >> {
    + id : BigAutoField [PK]
    + title : CharField(200)
    + system_type : CharField(20) [GAMING | UTILITY | ESIM | TREASURY, indexed]
